#include <Arduino.h>
#include "pump_controller.h"
#include "pump2_controller.h"
#include "case1_controller.h"
#include "float_switch.h"
#include "flow_sensor.h"
#include "system_switch.h"
#include "solenoid_valve.h"
#include "commissioning.h"

static void printHelpMenu() {
    Serial.println("\n==================================================");
    Serial.println("   LRC Stage 2 - Hardware Controller Test Menu    ");
    Serial.println("==================================================");
    Serial.println("System Commands:");
    Serial.println("  s / [Space] : SYSTEM EMERGENCY STOP (Halts all pumps & closes valve)");
    Serial.println("  p           : Print Full System Diagnostic Status");
    Serial.println("  h / ?       : Print this Help Menu");
    Serial.println("\nCommissioning & Diagnostic Commands:");
    Serial.println("  T / m       : Enter CASE 1 Commissioning / Hardware Test Mode");
    Serial.println("\nSensor & Auxiliary Commands:");
    Serial.println("  y           : Read System State (Software Control)");
    Serial.println("  t           : Read Sump Float Switch Status (GPIO 35)");
    Serial.println("  l           : Read Flow Sensor Status (YFS401 - GPIO 14)");
    Serial.println("  a           : Command Solenoid Valve OPEN (GPIO 27)");
    Serial.println("  c           : Command Solenoid Valve CLOSED (GPIO 27)");
    Serial.println("  k           : Toggle Solenoid Valve (OPEN <-> CLOSED)");
    Serial.println("\nCase 1 Simulation Commands:");
    Serial.println("  n : Simulate NORMAL condition (P1 -> 50%, P2 -> 100%)");
    Serial.println("  x : Simulate SUMP HIGH (Float tripped -> P1 OFF, P2 -> 100%)");
    Serial.println("  r : Simulate RETURN TO NORMAL (Float cleared -> P1 50%, P2 100%)");
    Serial.println("\nPump 1 Direct Overrides (ZQ-2201 #1 / U2 - GPIO 32/33/13/26):");
    Serial.println("  0 : Set Duty 0% (OFF)");
    Serial.println("  1 : Set Duty 25%");
    Serial.println("  2 : Set Duty 50%");
    Serial.println("  3 : Set Duty 75%");
    Serial.println("  4 : Set Duty 100%");
    Serial.println("  e : Pump 1 Enable / Clear E-Stop");
    Serial.println("  d : Pump 1 Disable");
    Serial.println("\nPump 2 Direct Overrides (ZQ-2201 #2 / U3 - GPIO 18/19/16/17):");
    Serial.println("  5 : Set Duty 25%");
    Serial.println("  6 : Set Duty 50%");
    Serial.println("  7 : Set Duty 75%");
    Serial.println("  8 : Set Duty 100%");
    Serial.println("  9 : Set Duty 0% (OFF)");
    Serial.println("  q : Pump 2 Enable / Clear E-Stop");
    Serial.println("  w : Pump 2 Disable");
    Serial.println("  z : Pump 2 Emergency Stop");
    Serial.println("  f : Pump 2 Direction: FORWARD");
    Serial.println("  v : Pump 2 Direction: REVERSE");
    Serial.println("  o : Print Pump 2 Status");
    Serial.println("==================================================\n");
}

static void handleSerialCommand(char cmd) {
    switch (cmd) {
        // --- 1. System Commands (Highest Priority) ---
        case 's':
        case 'S':
        case ' ': // Spacebar - System Emergency Stop
            case1TriggerEmergencyStop();
            break;

        case 'p':
        case 'P':
            printCase1Status();
            printSystemSwitchStatus();
            printFloatSwitchStatus();
            printFlowSensorStatus();
            printSolenoidStatus();
            printPump1Status();
            printPump2Status();
            break;

        case 'h':
        case 'H':
        case '?':
            printHelpMenu();
            break;

        // --- 2. Sensor & Auxiliary Inspection Commands ---
        case 'y':
        case 'Y':
            printSystemSwitchStatus();
            break;

        case 't':
            printFloatSwitchStatus();
            break;

        case 'T':
        case 'm':
        case 'M':
            enterCommissioningMode();
            break;

        case 'l':
        case 'L':
            printFlowSensorStatus();
            break;

        case 'a':
        case 'A':
            if (isCase1EmergencyStopActive()) {
                Serial.println("[SAFETY] Blocked: Cannot open solenoid while Emergency Stop is active.");
                break;
            }
            if (!isSystemOn()) {
                Serial.println("[SAFETY] Blocked: Cannot open solenoid while System Switch is OFF.");
                break;
            }
            openSolenoid();
            break;

        case 'c':
        case 'C':
            closeSolenoid();
            break;

        case 'k':
        case 'K':
            if (!isSolenoidOpen()) {
                if (isCase1EmergencyStopActive()) {
                    Serial.println("[SAFETY] Blocked: Cannot open solenoid while Emergency Stop is active.");
                    break;
                }
                if (!isSystemOn()) {
                    Serial.println("[SAFETY] Blocked: Cannot open solenoid while System Switch is OFF.");
                    break;
                }
            }
            toggleSolenoid();
            break;

        // --- 3. Case 1 Simulation Commands (r is strictly Return to Normal) ---
        case 'n':
        case 'N':
            if (isCase1EmergencyStopActive()) {
                case1ClearEmergencyStop();
            }
            case1TriggerSimulatedNormal();
            break;

        case 'x':
        case 'X':
            case1TriggerSimulatedSumpHigh();
            break;

        case 'r':
        case 'R':
            case1TriggerSimulatedReturnToNormal();
            break;

        // --- 4. Pump 1 Direct Manual Overrides (ZQ-2201 #1 / U2) ---
        case '0':
            Serial.println("\n>> Command: Pump 1 Set Duty 0%");
            setPump1Duty(0);
            break;
        case '1':
        case '2':
        case '3':
        case '4': {
            if (isCase1EmergencyStopActive()) {
                Serial.println("[SAFETY] Blocked: Emergency Stop is active! Press 'e' or 'n' to clear.");
                break;
            }
            if (!isSystemOn()) {
                Serial.println("[SAFETY] Blocked: Cannot run pump while System Switch is OFF.");
                break;
            }
            uint8_t duty = (cmd == '1') ? 25 : (cmd == '2') ? 50 : (cmd == '3') ? 75 : 100;
            Serial.printf("\n>> Command: Pump 1 Set Duty %d%%\n", duty);
            setPump1Duty(duty);
            if (!isCase1HardwareOutputEnabled()) {
                Serial.println("[SAFETY] Dry-Run Mode Active: Physical PWM/EN outputs remain suppressed.");
            }
            break;
        }
        case 'e':
        case 'E':
            if (isCase1EmergencyStopActive()) {
                case1ClearEmergencyStop();
            }
            if (!isSystemOn()) {
                Serial.println("[SAFETY] Blocked: Cannot enable driver while System Switch is OFF.");
                break;
            }
            Serial.println("\n>> Command: Enable Pump 1 Driver");
            enablePump1();
            if (!isCase1HardwareOutputEnabled()) {
                Serial.println("[SAFETY] Dry-Run Mode Active: Physical driver remains suppressed.");
            }
            break;
        case 'd':
        case 'D':
            Serial.println("\n>> Command: Disable Pump 1 Driver");
            disablePump1();
            break;

        // --- 5. Pump 2 Direct Manual Overrides (ZQ-2201 #2 / U3) ---
        case '5':
        case '6':
        case '7':
        case '8': {
            if (isCase1EmergencyStopActive()) {
                Serial.println("[SAFETY] Blocked: Emergency Stop is active! Press 'q' or 'n' to clear.");
                break;
            }
            if (!isSystemOn()) {
                Serial.println("[SAFETY] Blocked: Cannot run pump while System Switch is OFF.");
                break;
            }
            uint8_t duty = (cmd == '5') ? 25 : (cmd == '6') ? 50 : (cmd == '7') ? 75 : 100;
            Serial.printf("\n>> Command: Pump 2 Set Duty %d%%\n", duty);
            setPump2Duty(duty);
            if (!isCase1HardwareOutputEnabled()) {
                Serial.println("[SAFETY] Dry-Run Mode Active: Physical PWM/EN outputs remain suppressed.");
            }
            break;
        }
        case '9':
            Serial.println("\n>> Command: Pump 2 Set Duty 0%");
            setPump2Duty(0);
            break;
        case 'q':
        case 'Q':
            if (isCase1EmergencyStopActive()) {
                case1ClearEmergencyStop();
            }
            if (!isSystemOn()) {
                Serial.println("[SAFETY] Blocked: Cannot enable driver while System Switch is OFF.");
                break;
            }
            Serial.println("\n>> Command: Enable Pump 2 Driver");
            enablePump2();
            if (!isCase1HardwareOutputEnabled()) {
                Serial.println("[SAFETY] Dry-Run Mode Active: Physical driver remains suppressed.");
            }
            break;
        case 'w':
        case 'W':
            Serial.println("\n>> Command: Disable Pump 2 Driver");
            disablePump2();
            break;
        case 'z':
        case 'Z':
            Serial.println("\n>> Command: Pump 2 Emergency Stop");
            emergencyStopPump2();
            break;
        case 'f':
        case 'F':
            Serial.println("\n>> Command: Set Pump 2 Direction FORWARD");
            setPump2Direction(PUMP_DIR_FORWARD);
            break;
        case 'v':
        case 'V':
            Serial.println("\n>> Command: Set Pump 2 Direction REVERSE");
            setPump2Direction(PUMP_DIR_REVERSE);
            break;
        case 'o':
        case 'O':
            printPump2Status();
            break;

        case '\r':
        case '\n':
            // Ignore carriage return / newline
            break;
        default:
            Serial.printf("[CMD] Unknown command: '%c'. Send 'h' for help.\n", cmd);
            break;
    }
}

void setup() {
    Serial.begin(115200);
    delay(500);

    Serial.println("\n==================================================");
    Serial.println("LRC ESP32 Hardware Controller Initializing...");
    Serial.println("==================================================");

    // Initialize low-level pump hardware interfaces (strict safe boot state: OFF)
    initPump1();
    initPump2();

    // Initialize sensor & switch interfaces
    initSystemSwitch();
    initFloatSwitch();
    initFlowSensor();

    // Initialize auxiliary solenoid valve interface (safe boot state: CLOSED)
    initSolenoidValve();

    // Initialize Case 1 State Machine (Hardware outputs enabled)
    initCase1Controller();

    // Seed Case 1 with initial inputs (System Switch & Float Switch)
    updateCase1WithInputs(isSystemOn(), isFloatSwitchTriggered());

    // Display help menu and initial status
    printHelpMenu();
    printSystemSwitchStatus();
    printFloatSwitchStatus();
    printFlowSensorStatus();
    printSolenoidStatus();
    printCase1Status();
    printPump1Status();
    printPump2Status();
}

void loop() {
    // Continuously update/debounce sensor inputs
    updateSystemSwitch();
    updateFloatSwitch();
    updateFlowSensor();

    // Feed debounced inputs into the top-level safety & Case 1 state machine
    if (!isCommissioningModeActive()) {
        updateCase1WithInputs(isSystemOn(), isFloatSwitchTriggered());
    }

    // Non-blocking serial command processor
    while (Serial.available() > 0) {
        char c = (char)Serial.read();
        if (isCommissioningModeActive()) {
            handleCommissioningCommand(c);
        } else {
            handleSerialCommand(c);
        }
    }

    // Periodic heartbeat every 15 seconds
    static unsigned long lastHeartbeat = 0;
    if (millis() - lastHeartbeat >= 15000) {
        lastHeartbeat = millis();
        if (isCommissioningModeActive()) {
            Serial.printf("[HEARTBEAT] ESP32 Alive | MODE: COMMISSIONING | Sys: %s | Solenoid: %s | Flow: %.2f L/min | Float: %s\n",
                          isSystemOn() ? "ON" : "OFF",
                          isSolenoidOpen() ? "OPEN" : "CLOSED",
                          getFlowRateLPM(),
                          isFloatSwitchTriggered() ? "TRIGGERED" : "NORMAL");
        } else {
            Serial.printf("[HEARTBEAT] ESP32 Alive | Sys: %s | Solenoid: %s | Flow: %.2f L/min | Float: %s | Case 1: %s | Targets: P1=%s (%d%%), P2=%d%%\n",
                          isSystemOn() ? "ON" : "OFF",
                          isSolenoidOpen() ? "OPEN" : "CLOSED",
                          getFlowRateLPM(),
                          isFloatSwitchTriggered() ? "TRIGGERED" : "NORMAL",
                          getCase1StateStr(),
                          (getCase1Pump1TargetDuty() > 0) ? "RUNNING" : "OFF",
                          getCase1Pump1TargetDuty(),
                          getCase1Pump2TargetDuty());
        }
    }

    delay(10);
}