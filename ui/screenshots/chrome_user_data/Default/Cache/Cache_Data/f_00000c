/* =============================================================================
   LRC HARDWARE CONTROLLER - LIGHT INDUSTRIAL SCADA DASHBOARD
   Strictly engineered for zero-scroll single viewport display (100vh)
   Target resolutions: 1440x900, 1366x768, 1280x720
   ============================================================================= */

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  /* Light Industrial Theme Palette */
  --bg-app: #f8fafc;
  --bg-card: #ffffff;
  --bg-card-subtle: #f1f5f9;
  --bg-inner: #f8fafc;
  --bg-hover: #e2e8f0;

  --border-color: #e2e8f0;
  --border-strong: #cbd5e1;
  --border-focus: #0284c7;

  --text-main: #0f172a;
  --text-muted: #475569;
  --text-dim: #94a3b8;

  --color-blue: #0284c7;
  --color-blue-hover: #0369a1;
  --color-blue-light: #e0f2fe;

  --color-green: #16a34a;
  --color-green-light: #dcfce7;
  --color-green-border: #86efac;

  --color-amber: #d97706;
  --color-amber-light: #fef3c7;
  --color-amber-border: #fcd34d;

  --color-red: #dc2626;
  --color-red-light: #fee2e2;
  --color-red-border: #fca5a5;

  --color-pipe-bg: #cbd5e1;
  --color-pipe-active: #0284c7;

  --font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;

  --shadow-subtle: 0 1px 3px rgba(0, 0, 0, 0.05);
  --shadow-card: 0 1px 3px rgba(0, 0, 0, 0.06), 0 1px 2px rgba(0, 0, 0, 0.04);
}

html, body {
  width: 100vw;
  height: 100vh;
  max-width: 100vw;
  max-height: 100vh;
  overflow: hidden;
  background-color: var(--bg-app);
  color: var(--text-main);
  font-family: var(--font-family);
  font-size: 12.5px;
  line-height: 1.35;
  -webkit-font-smoothing: antialiased;
}

#dashboard-container {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  max-height: 100vh;
  overflow: hidden;
}

/* ================= 1. COMPACT TOP HEADER ================= */
#top-header {
  height: 38px;
  min-height: 38px;
  max-height: 38px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
  background: #ffffff;
  border-bottom: 1px solid var(--border-color);
  box-shadow: var(--shadow-subtle);
  z-index: 50;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-group {
  display: flex;
  align-items: center;
  gap: 6px;
}

.brand-icon {
  font-size: 15px;
  color: var(--color-blue);
}

.brand-title {
  font-weight: 700;
  letter-spacing: 0.4px;
  font-size: 12.5px;
  color: var(--text-main);
}

.brand-sub {
  font-size: 10px;
  padding: 1px 5px;
  background: var(--bg-card-subtle);
  border: 1px solid var(--border-strong);
  border-radius: 3px;
  color: var(--text-muted);
  font-weight: 600;
}

.header-pills {
  display: flex;
  align-items: center;
  gap: 6px;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 2px 7px;
  border-radius: 12px;
  font-size: 10px;
  font-weight: 600;
}

.pill-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.pill-online {
  background: var(--color-green-light);
  color: var(--color-green);
  border: 1px solid var(--color-green-border);
}
.pill-online .pill-dot {
  background: var(--color-green);
}

.pill-offline {
  background: var(--bg-card-subtle);
  color: var(--text-dim);
  border: 1px solid var(--border-color);
}
.pill-offline .pill-dot {
  background: var(--text-dim);
}

.pill-mock {
  background: var(--color-amber-light);
  color: var(--color-amber);
  border: 1px solid var(--color-amber-border);
}
.pill-mock .pill-dot {
  background: var(--color-amber);
}

.header-right {
  display: flex;
  align-items: center;
}

.btn-estop {
  background: var(--color-red);
  color: #ffffff;
  border: 1px solid #b91c1c;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.3px;
  border-radius: 4px;
}
.btn-estop:hover {
  background: #b91c1c;
}


/* ================= 2. THREE-COLUMN DASHBOARD GRID ================= */
#dashboard-grid {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 215px minmax(0, 1fr) 285px;
  gap: 8px;
  padding: 8px;
  overflow: hidden;
}

.dash-column {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 0;
  overflow: hidden;
}

/* Card Foundations */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.card-header {
  height: 28px;
  min-height: 28px;
  padding: 0 8px;
  background: var(--bg-card-subtle);
  border-bottom: 1px solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.3px;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 4px;
}

.card-body {
  padding: 8px;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.card-body.no-pad {
  padding: 0;
}


/* ================= LEFT COLUMN: NARROW TELEMETRY ================= */
/* A. Connection Card */
.connection-card {
  flex-shrink: 0;
  height: 120px;
}

.conn-row {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-bottom: 5px;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  min-width: 0;
}

.mock-row {
  justify-content: space-between;
  margin-bottom: 6px;
  width: 100%;
  box-sizing: border-box;
}

.control-select {
  flex: 1 1 0;
  min-width: 0;
  width: 0;
  max-width: 100%;
  height: 23px;
  background: #ffffff;
  border: 1px solid var(--border-strong);
  color: var(--text-main);
  border-radius: 3px;
  padding: 0 4px;
  font-size: 10.5px;
  font-family: var(--font-mono);
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.control-select:focus {
  border-color: var(--color-blue);
  outline: none;
}

.baud-tag {
  font-family: var(--font-mono);
  font-size: 9.5px;
  padding: 1px 4px;
  background: var(--bg-card-subtle);
  border: 1px solid var(--border-color);
  border-radius: 2px;
  color: var(--text-muted);
  flex-shrink: 0;
}

.mock-toggle-label {
  display: flex;
  align-items: center;
  gap: 4px;
  cursor: pointer;
  font-size: 10.5px;
  color: var(--color-amber);
  font-weight: 600;
  flex-shrink: 0;
}

.conn-actions {
  display: flex;
  gap: 5px;
  width: 100%;
  box-sizing: border-box;
}

.conn-actions .btn {
  flex: 1 1 0;
  min-width: 0;
  height: 22px;
  font-size: 10px;
  box-sizing: border-box;
}

.conn-status-msg {
  margin-top: 4px;
  font-size: 9.5px;
  color: var(--text-dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.activity-led {
  font-size: 11px;
  color: var(--border-strong);
  transition: color 0.1s ease;
}
.activity-led.active {
  color: var(--color-green);
}

/* B. Flow Table Card */
.flow-table-card {
  flex: 1;
  min-height: 0;
}

.table-header-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 5px;
}

.table-wrapper {
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

#flow-records-table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--font-mono);
  font-size: 10.5px;
  text-align: right;
}

#flow-records-table th {
  background: var(--bg-card-subtle);
  color: var(--text-muted);
  font-weight: 700;
  font-size: 9.5px;
  padding: 3px 5px;
  border-bottom: 1px solid var(--border-color);
  text-align: right;
}

#flow-records-table th:first-child {
  text-align: left;
}

#flow-records-table td {
  padding: 3px 5px;
  border-bottom: 1px solid #f1f5f9;
  color: var(--text-main);
  white-space: nowrap;
}

#flow-records-table td:first-child {
  text-align: left;
  color: var(--text-muted);
}

#flow-records-table tr:hover td {
  background: var(--color-blue-light);
}

.new-record-flash td {
  background: #f0fdf4 !important;
  color: var(--color-green) !important;
}

.empty-row td {
  text-align: center !important;
  color: var(--text-dim) !important;
  padding: 20px 4px !important;
  font-style: italic;
}

/* C. Data Actions Card */
.data-actions-card {
  flex-shrink: 0;
  height: 58px;
  padding: 5px 6px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.data-buttons-row {
  display: flex;
  gap: 5px;
}

.data-buttons-row .btn {
  flex: 1;
  height: 20px;
}

.legend-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 9.5px;
  color: var(--text-muted);
  padding: 0 2px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 3px;
}

.dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
}
.dot-green { background: var(--color-green); }
.dot-grey  { background: var(--text-dim); }
.dot-amber { background: var(--color-amber); }
.dot-red   { background: var(--color-red); }


/* ================= CENTER COLUMN: DOMINANT SCHEMATIC ================= */
#center-column {
  min-width: 0;
}

/* A. Compact Status & Action Toolbar immediately above schematic */
.center-toolbar-card {
  flex-shrink: 0;
  height: 36px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 10px;
  background: #ffffff;
  gap: 8px;
  min-width: 0;
  overflow-x: auto;
  scrollbar-width: none;
}
.center-toolbar-card::-webkit-scrollbar {
  display: none;
}

.status-indicator-group {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  flex: 0 1 auto;
  overflow: hidden;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 24px;
  padding: 0 10px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.3px;
  box-sizing: border-box;
  white-space: nowrap;
  min-width: 0;
  max-width: 100%;
}

#banner-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
}

.status-idle {
  background: #f1f5f9;
  color: #475569;
  border: 1px solid #cbd5e1;
}
.status-idle .status-dot {
  background: #64748b;
}

.status-normal {
  background: var(--color-green-light);
  color: var(--color-green);
  border: 1px solid var(--color-green-border);
}
.status-normal .status-dot {
  background: var(--color-green);
}

.status-sump-high {
  background: var(--color-amber-light);
  color: var(--color-amber);
  border: 1px solid var(--color-amber-border);
}
.status-sump-high .status-dot {
  background: var(--color-amber);
}

.status-flushing {
  background: var(--color-blue-light);
  color: var(--color-blue);
  border: 1px solid #7dd3fc;
}
.status-flushing .status-dot {
  background: var(--color-blue);
}

.status-shutdown {
  background: var(--bg-card-subtle);
  color: var(--text-muted);
  border: 1px solid var(--border-strong);
}
.status-shutdown .status-dot {
  background: var(--text-muted);
}

.status-estop {
  background: var(--color-red-light);
  color: var(--color-red);
  border: 1px solid var(--color-red-border);
}
.status-estop .status-dot {
  background: var(--color-red);
}

/* Integrated Flush Countdown Pill (Inside Schematic Header, Top-Right) */
.flush-monitor-pill {
  height: 20px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 0 6px;
  background: #f0f9ff;
  border: 1px solid #bae6fd;
  border-radius: 4px;
  font-size: 9.5px;
  color: var(--color-blue);
  font-weight: 700;
  white-space: nowrap;
  box-sizing: border-box;
  flex-shrink: 0;
}

.flush-icon {
  font-size: 10px;
  line-height: 1;
}

.flush-text {
  font-size: 9.5px;
  font-weight: 700;
  letter-spacing: 0.2px;
}

.flush-time {
  font-family: var(--font-mono);
  font-weight: 800;
  color: #0369a1;
  font-size: 10px;
}

.mini-progress-track {
  width: 36px;
  height: 4px;
  background: #e0f2fe;
  border-radius: 2px;
  overflow: hidden;
}

.mini-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0284c7, #38bdf8);
  width: 0%;
  border-radius: 2px;
  transition: width 0.1s linear;
}

.quick-actions-group {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
  margin-left: auto;
}

.btn-action {
  height: 24px;
  padding: 0 7px;
  font-size: 10.5px;
  font-weight: 600;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
  white-space: nowrap;
  box-sizing: border-box;
  line-height: 1;
}

.btn-highlight {
  background: var(--color-blue-light);
  border: 1px solid #7dd3fc;
  color: var(--color-blue);
}
.btn-highlight:hover {
  background: #bae6fd;
}

.btn-subtle {
  background: var(--bg-card-subtle);
  border: 1px solid var(--border-color);
  color: var(--text-muted);
}
.btn-subtle:hover {
  background: var(--bg-hover);
  color: var(--text-main);
}

.sim-dropdown-group {
  display: flex;
  align-items: center;
  gap: 3px;
}


/* B. Large Hydraulic Schematic Card */
.schematic-card {
  flex: 1;
  min-height: 0;
  position: relative;
}

.schematic-header {
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10px;
  gap: 8px;
  flex-shrink: 0;
  min-width: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.schematic-title-group {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
}

.schematic-title-group .card-title {
  flex-shrink: 0;
  white-space: nowrap;
}

.schematic-note {
  font-size: 9px;
  color: var(--text-dim);
  font-style: italic;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
  flex: 0 1 auto;
}

.schematic-badges {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
  margin-left: auto;
}

#schematic-mode-pill {
  white-space: nowrap;
  flex-shrink: 0;
}

.badge-tag {
  font-size: 9.5px;
  font-weight: 700;
  padding: 1px 6px;
  border-radius: 3px;
  font-family: var(--font-mono);
}

.badge-warning {
  background: var(--color-amber-light);
  color: var(--color-amber);
  border: 1px solid var(--color-amber-border);
}

.badge-info {
  background: var(--color-blue-light);
  color: var(--color-blue);
  border: 1px solid #bae6fd;
}

.schematic-canvas-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

#hydraulic-svg {
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  user-select: none;
}

/* SVG Styling */
.pipe-lines-bg path {
  stroke: var(--color-pipe-bg);
  stroke-width: 14;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.flow-line {
  stroke-width: 4.5;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
  opacity: 0;
  transition: opacity 0.2s ease;
  animation: none !important;
}

.flow-line.active {
  opacity: 1;
  stroke-dasharray: 8 6;
  animation: dashFlow 1s linear infinite !important;
}

.flow-p1 { stroke: #0284c7; }
.flow-p2 { stroke: #0284c7; }
.flow-p3 { stroke: #0ea5e9; }

@keyframes dashFlow {
  from { stroke-dashoffset: 28; }
  to { stroke-dashoffset: 0; }
}

.pipe-arrow {
  fill: #94a3b8;
}

/* Tanks */
.tank-body {
  fill: #ffffff;
  stroke: #94a3b8;
  stroke-width: 2;
  filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.04));
}

.tank-liquid {
  fill: url(#processWaterGrad);
}

.liquid-sump {
  fill: url(#sumpWaterGrad);
  transition: all 0.4s ease;
}

.liquid-flush {
  fill: url(#flushWaterGrad);
}

.tank-liquid-surface {
  stroke: #0284c7;
  stroke-width: 2;
  stroke-dasharray: 4 2;
  transition: all 0.35s ease;
}

.tank-title {
  fill: #0f172a;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.4px;
}

.tank-sub {
  fill: var(--text-muted);
  font-size: 10px;
  font-weight: 600;
}

.tank-desc {
  fill: var(--text-dim);
  font-size: 9px;
}

.unmeasured-tag-box {
  fill: var(--color-amber-light);
  stroke: var(--color-amber-border);
  stroke-width: 1;
}

.tank-unmeasured {
  fill: var(--color-amber);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.3px;
}

.tank-tag {
  fill: #94a3b8;
  font-size: 9.5px;
  font-weight: 700;
}

/* Float Switch in Sump */
.float-bracket {
  fill: #f1f5f9;
  stroke: #cbd5e1;
  stroke-width: 1.5;
}

.float-bob {
  stroke-width: 2;
  transition: cy 0.35s cubic-bezier(0.4, 0, 0.2, 1), fill 0.35s ease, stroke 0.35s ease;
}

.float-bob-normal {
  fill: #0284c7;
  stroke: #0369a1;
}

.float-bob-high {
  fill: var(--color-red);
  stroke: #b91c1c;
}

.float-title {
  fill: #0f172a;
  font-size: 9.5px;
  font-weight: 700;
}

.float-gpio {
  fill: var(--text-dim);
  font-size: 8.5px;
}

.float-status-text {
  fill: var(--color-blue);
  font-size: 10px;
  font-weight: 700;
  font-family: var(--font-mono);
}

/* Pumps (Directly Clickable) */
.interactive-comp {
  cursor: pointer;
}

.pump-circle {
  fill: #ffffff;
  stroke: #94a3b8;
  stroke-width: 3;
  transition: all 0.2s ease;
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.06));
}

.pump-group:hover .pump-circle {
  stroke: var(--color-blue);
  fill: #f0f9ff;
}

/* Rotor Impeller & Proportional Spinning Animation */
.pump-rotor-spinner {
  transform-box: fill-box;
  transform-origin: center;
  transition: fill 0.2s ease;
}

.rotor-blade {
  fill: #94a3b8;
  transition: fill 0.2s ease;
}

.pump-running .pump-circle {
  fill: #f0fdf4;
  stroke: var(--color-green);
  filter: drop-shadow(0 0 6px rgba(22, 163, 74, 0.35));
}

.pump-running .pump-rotor-spinner {
  animation: rotateRotor var(--rotor-speed, 1s) linear infinite;
}

.pump-running .rotor-blade {
  fill: var(--color-green);
}

.pump-stopped .pump-circle {
  fill: #ffffff;
  stroke: #94a3b8;
  filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.04));
}

.pump-stopped .pump-rotor-spinner {
  animation: none !important;
}

.pump-stopped .rotor-blade {
  fill: #94a3b8;
}

.pump-unconfirmed .pump-circle {
  fill: #fffbeb;
  stroke: #f59e0b;
  filter: none;
}

.pump-unconfirmed .pump-rotor-spinner {
  animation: none !important;
}

.pump-unconfirmed .rotor-blade {
  fill: #f59e0b;
}

@keyframes rotateRotor {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Center Hub & Readable Duty Badge */
.pump-hub {
  fill: #ffffff;
  stroke: #cbd5e1;
  stroke-width: 1.5;
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.06));
  transition: stroke 0.2s ease;
}

.pump-running .pump-hub {
  stroke: #86efac;
}

.pump-stopped .pump-hub {
  stroke: #cbd5e1;
}

.pump-unconfirmed .pump-hub {
  stroke: #fde68a;
}

.pump-name {
  fill: #0f172a;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.5px;
}

.pump-duty-badge {
  font-size: 13.5px;
  font-weight: 800;
  font-family: var(--font-mono);
  letter-spacing: -0.2px;
  transition: fill 0.2s ease;
  user-select: none;
  pointer-events: none;
}

.pump-duty-badge.duty-running,
.pump-running .pump-duty-badge {
  fill: #15803d; /* High-contrast deep emerald */
}

.pump-duty-badge.duty-stopped,
.pump-stopped .pump-duty-badge {
  fill: #475569; /* Crisp slate */
}

.pump-duty-badge.duty-unconfirmed,
.pump-unconfirmed .pump-duty-badge {
  fill: #d97706; /* High-contrast amber */
}

.comp-id-label {
  fill: #0f172a;
  font-size: 9.5px;
  font-weight: 700;
}

.comp-sub-label {
  fill: var(--text-muted);
  font-size: 8.5px;
}

.click-hint-dot {
  fill: var(--color-blue-light);
  stroke: #7dd3fc;
  stroke-width: 1;
}

.click-hint-text {
  fill: var(--color-blue);
  font-size: 8px;
  font-weight: bold;
}

/* Solenoid Valve */
.valve-group:hover .valve-symbol {
  filter: drop-shadow(0 0 5px rgba(2, 132, 199, 0.4));
}

.valve-symbol {
  stroke-width: 2;
  transition: all 0.2s ease;
}

.valve-open {
  fill: #dcfce7;
  stroke: var(--color-green);
}

.valve-closed {
  fill: #fee2e2;
  stroke: var(--color-red);
}

.valve-actuator {
  fill: #64748b;
}

.valve-state-text {
  font-size: 10px;
  font-weight: 800;
  font-family: var(--font-mono);
  fill: var(--color-green);
}

/* FT-01 Flow Sensor */
.sensor-circle {
  fill: #ffffff;
  stroke: #0284c7;
  stroke-width: 2.5;
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.06));
}

.turbine-blade {
  stroke: #0284c7;
  stroke-width: 1.5;
}

.sensor-tag {
  fill: #0f172a;
  font-size: 9px;
  font-weight: 800;
}

.flow-readout-pill {
  fill: var(--color-blue-light);
  stroke: #bae6fd;
  stroke-width: 1;
}

.sensor-live-val {
  fill: #0369a1;
  font-size: 9.5px;
  font-weight: 800;
  font-family: var(--font-mono);
}

/* Manual Ball Valve */
.manual-valve-symbol {
  fill: var(--color-amber-light);
  stroke: var(--color-amber);
  stroke-width: 1.5;
}

.ball-valve-lever {
  fill: var(--color-amber);
}

.manual-unverified-tag {
  fill: var(--color-amber);
  font-size: 8.5px;
  font-weight: 700;
}

/* Equal Tee */
.tee-circle {
  fill: #0284c7;
}

.tee-label {
  fill: var(--text-dim);
  font-size: 8.5px;
  font-weight: 600;
}

/* System Switch & Flush Button Cards inside SVG */
.switch-badge-box, .flush-btn-box {
  fill: #ffffff;
  stroke: var(--border-strong);
  stroke-width: 1.5;
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.04));
}

.switch-led {
  stroke-width: 2;
}

.switch-led-on {
  fill: var(--color-green);
  stroke: var(--color-green-border);
}

.switch-led-off {
  fill: var(--color-red);
  stroke: var(--color-red-border);
}

.switch-badge-title, .flush-btn-title {
  fill: #0f172a;
  font-size: 9px;
  font-weight: 700;
}

.switch-badge-val {
  fill: var(--color-green);
  font-size: 10px;
  font-weight: 700;
  font-family: var(--font-mono);
}

.flush-btn-led {
  fill: #e2e8f0;
  stroke: #94a3b8;
  stroke-width: 2;
  transition: all 0.3s ease;
}

.flush-btn-active .flush-btn-led {
  fill: var(--color-red);
  stroke: #fca5a5;
  filter: drop-shadow(0 0 6px rgba(220, 38, 38, 0.6));
  animation: pulseButton 0.8s infinite;
}

.flush-btn-val {
  fill: var(--text-muted);
  font-size: 10px;
  font-weight: 700;
  font-family: var(--font-mono);
}

/* Popovers for Direct Component Interaction */
.comp-popover {
  position: absolute;
  background: #ffffff;
  border: 1px solid var(--border-strong);
  border-radius: 6px;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  z-index: 100;
  min-width: 200px;
  max-width: 260px;
  padding: 10px;
  font-size: 11px;
}

.popover-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--border-color);
  padding-bottom: 5px;
  margin-bottom: 8px;
  font-weight: 700;
  color: var(--text-main);
}

.btn-close {
  background: none;
  border: none;
  color: var(--text-dim);
  font-size: 16px;
  cursor: pointer;
  line-height: 1;
}
.btn-close:hover { color: var(--text-main); }

.popover-body {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.popover-row {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
}

.popover-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 4px;
  margin-top: 8px;
}


/* ================= RIGHT COLUMN: GRAPH & CONSOLE ================= */
/* A. Flow Rate Graph */
.graph-card {
  flex: 1.1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.graph-metrics-banner {
  display: flex;
  gap: 8px;
  padding: 4px 8px;
  background: var(--bg-card-subtle);
  border-bottom: 1px solid var(--border-color);
}

.metric-block {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 3px;
}

.metric-label {
  font-size: 9px;
  font-weight: 700;
  color: var(--text-muted);
}

.metric-val {
  font-family: var(--font-mono);
  font-size: 12.5px;
  font-weight: 800;
  color: var(--color-blue);
}

.metric-unit {
  font-size: 9px;
  color: var(--text-dim);
}

.graph-canvas-wrapper {
  position: relative;
  flex: 1;
  min-height: 0;
  width: 100%;
  background: #ffffff;
}

#flow-graph-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.graph-footer {
  padding: 3px 8px;
  background: var(--bg-card-subtle);
  border-top: 1px solid var(--border-color);
  font-size: 9px;
  color: var(--text-dim);
}

/* B. Tabbed Console */
.terminal-card {
  flex: 0.9;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.tab-header {
  padding: 0 6px;
}

.tabs-group {
  display: flex;
  gap: 2px;
}

.tab-btn {
  background: none;
  border: none;
  padding: 4px 8px;
  font-size: 10px;
  font-weight: 700;
  color: var(--text-muted);
  cursor: pointer;
  border-bottom: 2px solid transparent;
}

.tab-btn.tab-active {
  color: var(--color-blue);
  border-bottom-color: var(--color-blue);
}

.tab-panel {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  padding: 5px 6px;
  background: #ffffff;
}

.log-entries-list {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 3px;
  font-family: var(--font-mono);
  font-size: 10px;
}

.log-item {
  display: flex;
  gap: 6px;
  padding: 2px 4px;
  border-radius: 2px;
}
.log-item:hover {
  background: var(--bg-card-subtle);
}

.log-time {
  color: var(--text-dim);
  font-size: 9px;
  flex-shrink: 0;
}

.log-msg {
  color: var(--text-main);
  word-break: break-word;
}

.log-warn .log-msg { color: var(--color-amber); font-weight: 600; }
.log-error .log-msg { color: var(--color-red); font-weight: 600; }
.log-success .log-msg { color: var(--color-green); font-weight: 600; }

.raw-terminal-box {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  font-family: var(--font-mono);
  font-size: 9.5px;
  color: #1e293b;
  background: #f8fafc;
  border: 1px solid var(--border-color);
  padding: 4px;
  border-radius: 3px;
  white-space: pre-wrap;
  margin-bottom: 4px;
}

.terminal-input-bar {
  display: flex;
  gap: 4px;
}

#term-input {
  flex: 1;
  height: 22px;
  background: #ffffff;
  border: 1px solid var(--border-strong);
  border-radius: 3px;
  padding: 0 6px;
  color: var(--text-main);
  font-family: var(--font-mono);
  font-size: 10px;
}
#term-input:focus {
  border-color: var(--color-blue);
  outline: none;
}


/* ================= BUTTONS & UTILITIES ================= */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid transparent;
  border-radius: 4px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
  user-select: none;
}

.btn-primary {
  background: var(--color-blue);
  color: #ffffff;
}
.btn-primary:hover:not(:disabled) {
  background: var(--color-blue-hover);
}

.btn-secondary {
  background: var(--bg-card-subtle);
  border: 1px solid var(--border-color);
  color: var(--text-muted);
}
.btn-secondary:hover:not(:disabled) {
  background: var(--bg-hover);
  color: var(--text-main);
}

.btn-outline {
  background: transparent;
  border: 1px solid var(--border-color);
  color: var(--text-muted);
}
.btn-outline:hover:not(:disabled) {
  border-color: var(--border-strong);
  color: var(--text-main);
  background: var(--bg-card-subtle);
}

.btn-icon {
  width: 23px;
  height: 23px;
  flex-shrink: 0;
  box-sizing: border-box;
  background: var(--bg-card-subtle);
  border: 1px solid var(--border-color);
  color: var(--text-muted);
  border-radius: 3px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
}
.btn-icon:hover {
  color: var(--text-main);
  border-color: var(--border-strong);
}

.btn-sm {
  height: 22px;
  padding: 0 6px;
  font-size: 10px;
}

.btn-tiny {
  height: 19px;
  padding: 0 5px;
  font-size: 9px;
}

.btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.badge-tag {
  font-size: 9px;
  font-weight: 700;
  padding: 1px 5px;
  border-radius: 3px;
  font-family: var(--font-mono);
}

.badge-idle {
  background: var(--bg-card-subtle);
  color: var(--text-dim);
  border: 1px solid var(--border-color);
}

.badge-active {
  background: var(--color-green-light);
  color: var(--color-green);
  border: 1px solid var(--color-green-border);
}

.badge-waiting {
  background: var(--color-amber-light);
  color: var(--color-amber);
  border: 1px solid var(--color-amber-border);
}

.badge-stale {
  background: var(--color-red-light);
  color: var(--color-red);
  border: 1px solid var(--color-red-border);
}

.hidden {
  display: none !important;
}

@keyframes pulseButton {
  0%, 100% { fill: var(--color-red); }
  50% { fill: #991b1b; }
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 4px;
  height: 4px;
}
::-webkit-scrollbar-track {
  background: var(--bg-card-subtle);
}
::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 2px;
}
::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* Responsive adjustment for 1280x720 screens */
@media (max-height: 750px) {
  #top-header { height: 34px; min-height: 34px; }
  .center-toolbar-card { height: 32px; }
  .connection-card { height: 112px; }
  .btn-action { height: 22px; font-size: 10px; }
  #dashboard-grid { gap: 6px; padding: 6px; }
}
